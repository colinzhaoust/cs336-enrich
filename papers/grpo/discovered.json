      },
      {
        "step": 4,
        "text": "for step = 1, …, M do"
      },
      {
        "step": 5,
        "text": "Sample a batch $\\mathcal{D}_{b}$ from $\\mathcal{D}$"
      },
      {
        "step": 6,
        "text": "Update the old policy model $\\pi_{\\theta_{old}}\\leftarrow\\pi_{\\theta}$"
      },
      {
        "step": 7,
        "text": "Sample $G$ outputs $\\{o_{i}\\}_{i=1}^{G}\\sim\\pi_{\\theta_{old}}(\\cdot\\mid q)$ for each question $q\\in\\mathcal{D}_{b}$"
      },
      {
        "step": 8,
        "text": "Compute rewards $\\{r_{i}\\}_{i=1}^{G}$ for each sampled output $o_{i}$ by running $r_{\\varphi}$"
      },
      {
        "step": 9,
        "text": "Compute $\\hat{A}_{i,t}$ for the $t$ -th token of $o_{i}$ through group relative advantage estimation."
      },
      {
        "step": 10,
        "text": "for GRPO iteration = 1, …, $\\mu$ do"
      },
      {
        "step": 11,
        "text": "Update the policy model $\\pi_{\\theta}$ by maximizing the GRPO objective (Equation 21)"
      },
      {
        "step": 12,
        "text": "Update $r_{\\varphi}$ through continuous training using a replay mechanism."
      }
    ]
  },
