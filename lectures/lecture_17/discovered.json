      "kind": "claim",
      "line": 11,
      "section": "main",
      "depth": 0,
      "text": "Ultimate goal: **omni model**",
      "extra": {}
    },
    {
      "kind": "claim",
      "line": 12,
      "section": "main",
      "depth": 0,
      "text": "- Input any combination of modalities (understanding)",
