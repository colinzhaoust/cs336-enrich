# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp
*.temp
*.log

# Python and local environments
**/__pycache__/
*.py[cod]
.venv/
.venv-*/

# Local render/test output
build/
dist/
**/partial_movie_files/
**/Tex/
**/texts/
/scenes/**/media/

# Augmentation directories contain text only; QA image/video sheets stay local.
/augmentations/**/*.png
/augmentations/**/*.jpg
/augmentations/**/*.jpeg
/augmentations/**/*.gif
/augmentations/**/*.mp4

# Published media is an explicit allowlist: 12 MP4 files and 12 posters.
